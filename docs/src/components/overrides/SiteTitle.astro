---
/**
 * Header site title: the logo (light/dark pair from the `logo` config) next
 * to the code-style wordmark `maplibre: yaml`. The wordmark is visual only;
 * screen readers get the plain site title. The homepage hero repeats the same
 * markup in `hero.title` (src/content/docs/index.mdx) — keep the two in step.
 */
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    logos.dark && (
      <img
        class="light:sl-hidden print:hidden"
        alt={config.logo?.alt ?? ""}
        src={logos.dark.src}
        width={logos.dark.width}
        height={logos.dark.height}
      />
    )
  }
  {
    logos.light && (
      <img
        class="dark:sl-hidden print:block"
        alt={config.logo?.alt ?? ""}
        src={logos.light.src}
        width={logos.light.width}
        height={logos.light.height}
      />
    )
  }
  <span class="wordmark" translate="no">
    <span class="sr-only">{siteTitle}</span>
    <span aria-hidden="true"
      ><span class="wordmark-key">maplibre:</span> <span class="wordmark-value">yaml</span></span
    >
  </span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .wordmark {
    overflow: hidden;
  }
  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
</style>
