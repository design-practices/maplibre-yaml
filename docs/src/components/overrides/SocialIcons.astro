---
/**
 * Examples and Playground links in the site header, before the GitHub icon.
 *
 * Starlight has no header navigation of its own; overriding `SocialIcons` is
 * the supported hook for it. Starlight renders this component in two places:
 * the desktop header's right-hand group (next to search, before the theme
 * picker) and the mobile menu's footer. So the links are on the header bar on
 * desktop and in the menu on phones, where the header itself stays as it is
 * (pages without a sidebar get a menu for it from Search.astro).
 * Only one of the two is ever displayed, so the `nav` landmark is never
 * announced twice. The default icons (GitHub) render unchanged after the links.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const path = Astro.url.pathname;
const links = [
  { label: 'Examples', href: '/examples/' },
  { label: 'Playground', href: '/playground/' },
].map((link) => ({ ...link, current: path === link.href || path.startsWith(link.href) }));
---

<nav class="header-links" aria-label="Site">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<Default />

<style>
  .header-links ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header-links a {
    display: block;
    /* A comfortable target without moving the text off the header's line. */
    padding: 0.5rem 0.125rem;
    margin: -0.5rem -0.125rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.25;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 0.25rem;
  }
  .header-links a:hover {
    color: var(--sl-color-white);
  }
  .header-links a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
  }
  .header-links a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
