---
import Base from "../layouts/Base.astro";
import { Map } from "@maplibre-yaml/astro";
---

<Base title="Cloud-native data">
  <main>
    <h1>Cloud-native data</h1>
    <p class="lede">
      A PMTiles archive (the outlines), a FlatGeobuf file (the coloured districts) and a
      GeoParquet file (the population classes), named in YAML like any other file. No page
      JavaScript: <code>@maplibre-yaml/core</code> reads all three.
    </p>
    <div class="map-frame" data-testid="cloud-native-map">
      <Map src="/maps/cloud-native.yaml" height="460px" />
    </div>
  </main>
</Base>
