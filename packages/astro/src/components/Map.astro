---
/**
 * @file Basic Map component for inline maps
 * @module @maplibre-yaml/astro/components/Map
 *
 * @description
 * A basic map component that renders an interactive MapLibre map using
 * YAML configuration. Supports both build-time loaded configs and runtime
 * loading from public directory.
 *
 * ## Features
 *
 * - **Dual Loading**: Use `config` for build-time or `src` for runtime
 * - **Web Component**: Wraps the `<ml-map>` web component from @maplibre-yaml/core
 * - **Customizable**: Height, class, and style props for layout control
 * - **Type Safe**: Full TypeScript support with MapBlock validation
 *
 * @example Build-time loading
 * ```astro
 * ---
 * import { Map, loadMapConfig } from '@maplibre-yaml/astro';
 * const config = await loadMapConfig('./src/configs/earthquake-map.yaml');
 * ---
 * <Map config={config} height="500px" />
 * ```
 *
 * @example Runtime loading
 * ```astro
 * ---
 * import { Map } from '@maplibre-yaml/astro';
 * ---
 * <Map src="/configs/map.yaml" height="400px" />
 * ```
 *
 * @example Corner slots (forwarded to `<ml-map>`'s corner system)
 * ```astro
 * <Map config={config}>
 *   <p slot="top-left" class="caption">Ring of Fire</p>
 *   <a slot="bottom-right" href="/about">About this map</a>
 * </Map>
 * ```
 *
 * @example With custom styling
 * ```astro
 * <Map
 *   src="/configs/dashboard.yaml"
 *   height="600px"
 *   class="map-container"
 *   style="border: 2px solid #ccc; border-radius: 8px;"
 * />
 * ```
 *
 * @example Reaching the element from a page script (live documents, core 0.10)
 * ```astro
 * <Map id="quakes" config={config} />
 * <script>
 *   const el = document.getElementById("quakes");
 *   el.addEventListener("ml-map:update-applied", (e) => console.log(e.detail.summary));
 *   el.update(nextDocument); // applied in place: the camera stays, getMap() is the same map
 * </script>
 * ```
 */

import type { MapProps } from "../types";
import { withBase } from "../utils/base-url";
// MapLibre's stylesheet as PAGE css, imported here rather than in the
// client script: Astro then links it in the page head in dev and build alike.
// From the script, astro dev injected it with JS as a <style> the server
// never rendered, and <ClientRouter />'s head swap dropped it after the first
// soft navigation -- controls and attribution fell out of the map (ml-aot.22).
import "maplibre-gl/dist/maplibre-gl.css";

interface Props extends MapProps {}

const {
  id,
  camera,
  src,
  config,
  height = "400px",
  class: className,
  style,
  base,
  quiet = false,
  debug = false,
} = Astro.props;

// Validate that either src or config is provided
if (!src && !config) {
  throw new Error("Map component requires either 'src' or 'config' prop");
}

// If both are provided, prefer config
if (src && config) {
  console.warn(
    "Map component received both 'src' and 'config' props. Using 'config' and ignoring 'src'."
  );
}

// The element's id: the author's, so page scripts can reach it
// (`document.getElementById(id).update(doc)`), or a generated one.
const mapId = id ?? `map-${Math.random().toString(36).substring(2, 11)}`;

// Serialize config for client-side if provided
const serializedConfig = config ? JSON.stringify(config) : null;

// `/configs/map.yaml` lives at `/<base>/configs/map.yaml` on a site deployed
// under a subpath (GitHub Pages project sites) -- see utils/base-url.ts.
const resolvedSrc = withBase(src, import.meta.env.BASE_URL);

// Every path INSIDE the document -- source urls, images, marker icons --
// resolves against the site's base too, so YAML written for `public/`
// (`/data/x.geojson` or `data/x.geojson`) works on every page and under a
// GitHub Pages subpath (ml-aot.30). Always set, "/" included: files in
// public/ are site paths, never page-relative. `base={false}` opts out.
const documentBase = base === false ? undefined : (base ?? import.meta.env.BASE_URL);
---

<div
  class:list={["ml-map-container", className]}
  style={`height: ${height}; width: 100%; position: relative; ${style || ""}`}
  data-map-id={mapId}
>
  {/*
    `src` goes to <ml-map> as-is: the element fetches, parses, validates and
    shows its own error card. This used to be an `is:inline` script that
    re-did all of that through `import("@maplibre-yaml/core")` -- a bare
    specifier an un-bundled inline script cannot resolve in a browser, so
    every `<Map src>` failed with "Failed to resolve module specifier".
  */}
  <ml-map
    id={mapId}
    config={serializedConfig ?? undefined}
    src={serializedConfig ? undefined : resolvedSrc}
    base={documentBase}
    camera={camera}
    quiet={quiet ? "" : undefined}
    debug={debug ? "" : undefined}
  >
    {/*
      Corner slots (ml-l4y.3). Astro reads a child's `slot="top-left"` as a
      named slot of THIS component, so it would never reach <ml-map>; each
      one is re-emitted as an <ml-map> slot child. The attribute is spread
      because the compiler strips a literal `slot="…"` inside an expression,
      and slot names are spelled out because <slot name> must be static.
    */}
    {Astro.slots.has("top-left") && (
      <div {...{ slot: "top-left" }} class="ml-astro-slot" data-ml-slot="top-left">
        <slot name="top-left" />
      </div>
    )}
    {Astro.slots.has("top-right") && (
      <div {...{ slot: "top-right" }} class="ml-astro-slot" data-ml-slot="top-right">
        <slot name="top-right" />
      </div>
    )}
    {Astro.slots.has("bottom-left") && (
      <div {...{ slot: "bottom-left" }} class="ml-astro-slot" data-ml-slot="bottom-left">
        <slot name="bottom-left" />
      </div>
    )}
    {Astro.slots.has("bottom-right") && (
      <div {...{ slot: "bottom-right" }} class="ml-astro-slot" data-ml-slot="bottom-right">
        <slot name="bottom-right" />
      </div>
    )}
    {Astro.slots.has("legend") && (
      <div {...{ slot: "legend" }} class="ml-astro-slot" data-ml-slot="legend">
        <slot name="legend" />
      </div>
    )}
  </ml-map>
</div>

<script>
  // first: maplibre-gl 6 needs its worker URL before any map is built
  import "../client/maplibre-worker";
  // astro dev only: a page with no viewport meta (tiny map on phones)
  import "../client/dev-hints";
  import "@maplibre-yaml/core/register";
</script>

<style>
  .ml-map-container {
    display: block;
    overflow: hidden;
  }

  ml-map {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
