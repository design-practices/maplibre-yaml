---
/**
 * @file Chapter component for scrollytelling narratives
 * @module @maplibre-yaml/astro/components/Chapter
 *
 * @description
 * One chapter section of a scrollytelling story: title, HTML description,
 * optional image or video, alignment, theme. `<Scrollytelling>` no longer
 * uses it (core's `<ml-scrollytelling>` renders its chapters from the same
 * renderer this component calls), but it stays for pages that lay out
 * chapters themselves.
 *
 * The markup and the styles both come from `@maplibre-yaml/core`
 * (`chapterHTML`, `scrollytelling.css`), so a chapter rendered here is
 * identical to one rendered by a story.
 *
 * @example Basic chapter
 * ```astro
 * <Chapter
 *   id="intro"
 *   title="Introduction"
 *   description="<p>Welcome to our story.</p>"
 *   alignment="left"
 * />
 * ```
 *
 * @example Hidden chapter (map-only)
 * ```astro
 * <Chapter id="transition" title="Transition" hidden />
 * ```
 */

import { chapterHTML } from "@maplibre-yaml/core/scrollytelling";
import "@maplibre-yaml/core/scrollytelling.css";
import type { Chapter as ChapterType } from "@maplibre-yaml/core/schemas";
import type { ChapterProps } from "../types";

interface Props extends ChapterProps {}

const {
  id,
  title,
  description,
  image,
  video,
  alignment = "center",
  hidden = false,
  theme = "light",
  isActive = false,
} = Astro.props;

const markup = chapterHTML(
  { id, title, description, image, video, alignment, hidden } as unknown as ChapterType,
  { theme, isActive }
);
---

<Fragment set:html={markup} />
