---
/**
 * @file Scrollytelling component for narrative map stories
 * @module @maplibre-yaml/astro/components/Scrollytelling
 *
 * @description
 * Creates an immersive scrollytelling experience where the map transitions
 * between different views as users scroll through narrative chapters.
 * Perfect for data journalism, interactive reports, and guided tours.
 *
 * Since @maplibre-yaml/core 0.8 this is a thin wrapper over core's
 * `<ml-scrollytelling>` web component: the same element a plain HTML page
 * uses from the CDN, so both paths run one engine (camera, layers, chapter
 * actions, the rail, reduced motion, events).
 *
 * - **`config`** (build time): the story is rendered to HTML here -- the
 *   sticky `<ml-map>` with its document, every chapter, the rail and the
 *   footer -- and the element takes it over in the browser, so the chapters
 *   are in the page before any script runs.
 * - **`src`** (runtime): the element fetches, validates and renders the
 *   story in the browser; until then a loading state shows, and a story that
 *   fails shows one error card with line numbers.
 *
 * Corner slots (`slot="top-left|top-right|bottom-left|bottom-right|legend"`)
 * reach the story's `<ml-map>` either way.
 *
 * Events: `ml-scrollytelling:chapter`, `ml-scrollytelling:action` and
 * `ml-scrollytelling:error`, dispatched on the story element (which keeps
 * the `scrollytelling-container` class and `data-active-chapter`).
 *
 * @example Runtime loading
 * ```astro
 * ---
 * import { Scrollytelling } from '@maplibre-yaml/astro';
 * ---
 * <Scrollytelling src="/stories/climate-change.yaml" />
 * ```
 *
 * @example Build-time loading
 * ```astro
 * ---
 * import { Scrollytelling, loadScrollytellingConfig } from '@maplibre-yaml/astro';
 * const config = await loadScrollytellingConfig('./src/stories/earthquake.yaml');
 * ---
 * <Scrollytelling config={config} />
 * ```
 *
 * @example Debug mode
 * ```astro
 * <Scrollytelling src="/stories/test.yaml" debug />
 * ```
 */

import {
  storyMapDocument,
  chaptersHTML,
  footerHTML,
  railHTML,
} from "@maplibre-yaml/core/scrollytelling";
// The element injects these rules itself; importing the file too styles a
// server-rendered story from the first paint.
import "@maplibre-yaml/core/scrollytelling.css";
import type { ScrollytellingProps } from "../types";

interface Props extends ScrollytellingProps {}

const { src, config, class: className, debug = false } = Astro.props;

if (!src && !config) {
  throw new Error("Scrollytelling component requires either 'src' or 'config' prop");
}

const theme = config?.theme ?? "light";

// Generate unique ID for this instance
const storyId = `scrolly-${Math.random().toString(36).substring(2, 11)}`;

// The story for the element (it validates it again in the browser), and the
// map half as a real map document, rendered straight onto <ml-map> so the map
// starts loading before the element upgrades.
const serializedConfig = config ? JSON.stringify(config) : undefined;
const mapDocument = config ? JSON.stringify(storyMapDocument(config)) : undefined;
const chapterMarkup = config ? chaptersHTML(config) + footerHTML(config) : "";
const railMarkup = config ? railHTML(config) : "";

const hasSlot = {
  "top-left": Astro.slots.has("top-left"),
  "top-right": Astro.slots.has("top-right"),
  "bottom-left": Astro.slots.has("bottom-left"),
  "bottom-right": Astro.slots.has("bottom-right"),
  legend: Astro.slots.has("legend"),
};
---

<ml-scrollytelling
  class:list={[
    "scrollytelling-container",
    config && `theme-${theme}`,
    config?.className,
    className,
    { debug, "has-markers": config?.showMarkers === true },
  ]}
  style={config?.style}
  id={storyId}
  src={config ? undefined : src}
  config={serializedConfig}
>
  {/*
    Corner slots (ml-l4y.3). Astro reads a child's `slot="top-left"` as a
    named slot of THIS component, so it would never reach <ml-map>; each one
    is re-emitted as a slot child. The attribute is spread because the
    compiler strips a literal `slot="…"` inside an expression, and slot names
    are spelled out because <slot name> must be static. With `config` they go
    straight into the server-rendered <ml-map>; with `src` they sit on
    <ml-scrollytelling>, which hands them to the map it creates.
  */}
  {config ? (
    <div class="scrolly-map-container">
      <ml-map id={`${storyId}-map`} config={mapDocument}>
        {hasSlot["top-left"] && (
          <div {...{ slot: "top-left" }} class="ml-astro-slot" data-ml-slot="top-left">
            <slot name="top-left" />
          </div>
        )}
        {hasSlot["top-right"] && (
          <div {...{ slot: "top-right" }} class="ml-astro-slot" data-ml-slot="top-right">
            <slot name="top-right" />
          </div>
        )}
        {hasSlot["bottom-left"] && (
          <div {...{ slot: "bottom-left" }} class="ml-astro-slot" data-ml-slot="bottom-left">
            <slot name="bottom-left" />
          </div>
        )}
        {hasSlot["bottom-right"] && (
          <div {...{ slot: "bottom-right" }} class="ml-astro-slot" data-ml-slot="bottom-right">
            <slot name="bottom-right" />
          </div>
        )}
        {hasSlot.legend && (
          <div {...{ slot: "legend" }} class="ml-astro-slot" data-ml-slot="legend">
            <slot name="legend" />
          </div>
        )}
      </ml-map>
      <Fragment set:html={railMarkup} />
    </div>
  ) : (
    <Fragment>
      {hasSlot["top-left"] && (
        <div {...{ slot: "top-left" }} class="ml-astro-slot" data-ml-slot="top-left">
          <slot name="top-left" />
        </div>
      )}
      {hasSlot["top-right"] && (
        <div {...{ slot: "top-right" }} class="ml-astro-slot" data-ml-slot="top-right">
          <slot name="top-right" />
        </div>
      )}
      {hasSlot["bottom-left"] && (
        <div {...{ slot: "bottom-left" }} class="ml-astro-slot" data-ml-slot="bottom-left">
          <slot name="bottom-left" />
        </div>
      )}
      {hasSlot["bottom-right"] && (
        <div {...{ slot: "bottom-right" }} class="ml-astro-slot" data-ml-slot="bottom-right">
          <slot name="bottom-right" />
        </div>
      )}
      {hasSlot.legend && (
        <div {...{ slot: "legend" }} class="ml-astro-slot" data-ml-slot="legend">
          <slot name="legend" />
        </div>
      )}
    </Fragment>
  )}

  <div class="scrolly-chapters">
    {config ? (
      <Fragment set:html={chapterMarkup} />
    ) : (
      <div class="chapters-loading" role="status">
        <div class="loading-spinner" />
        <p>Loading story...</p>
      </div>
    )}
  </div>
</ml-scrollytelling>

<script>
  // first: maplibre-gl 6 needs its worker URL before any map is built
  import "../client/maplibre-worker";
  // registers <ml-map> and <ml-scrollytelling> -- the whole story runtime
  import "@maplibre-yaml/core/register";
  import "maplibre-gl/dist/maplibre-gl.css";
</script>
