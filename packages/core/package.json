{
  "name": "@maplibre-yaml/core",
  "version": "0.8.1",
  "description": "Declarative MapLibre web maps from YAML: the <ml-map> and <ml-scrollytelling> web components, parser, schemas and renderer",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register.browser": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.browser.js"
    },
    "./maplibre": {
      "types": "./dist/maplibre.d.ts",
      "import": "./dist/maplibre.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./schemas/json/*": "./schemas/*",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./scrollytelling": {
      "types": "./dist/scrollytelling/index.d.ts",
      "import": "./dist/scrollytelling/index.js"
    },
    "./scrollytelling.css": "./dist/scrollytelling.css",
    "./index.browser": "./dist/index.browser.js"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "schemas",
    "register.js",
    "maplibre.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && pnpm run emit-schema && pnpm run emit-css",
    "emit-schema": "tsx scripts/emit-json-schema.ts",
    "emit-css": "tsx scripts/emit-scrollytelling-css.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist schemas *.tsbuildinfo"
  },
  "dependencies": {
    "flatgeobuf": "^4.6.0",
    "pmtiles": "^4.5.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^1.4.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^24.0.0",
    "maplibre-gl": "^6.12.0",
    "react-types-18": "npm:@types/react@^18.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "maplibre-gl": "^3.0.0 || ^4.0.0 || ^5.0.0 || ^6.4.1"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": false
    },
    "@types/react": {
      "optional": true
    }
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "maps",
    "yaml",
    "geojson",
    "web-components",
    "declarative",
    "scrollytelling",
    "story-map"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/design-practices/maplibre-yaml.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/design-practices/maplibre-yaml/issues"
  },
  "homepage": "https://docs.maplibre-yaml.org/"
}
