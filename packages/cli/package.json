{
  "name": "@maplibre-yaml/cli",
  "version": "0.6.2",
  "description": "Command line for maplibre-yaml: scaffold a project, validate and preview YAML maps, export them to MapLibre style.json",
  "type": "module",
  "bin": {
    "maplibre-yaml": "dist/cli.js",
    "mlym": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "chmod +x dist/cli.js"
  },
  "dependencies": {
    "@maplibre-yaml/core": "workspace:^",
    "chokidar": "^4.0.3",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "pathe": "^1.1.2",
    "picocolors": "^1.0.0",
    "sharp": "0.35.5",
    "tinyglobby": "^0.2.17",
    "vite": "^6.4.4",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "yaml",
    "cli",
    "validation",
    "preview",
    "scaffold",
    "style-json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/design-practices/maplibre-yaml.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/design-practices/maplibre-yaml/issues"
  },
  "homepage": "https://docs.maplibre-yaml.org/cli/getting-started/"
}
