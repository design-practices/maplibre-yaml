---
// A page that renders public/configs/map.yaml with @maplibre-yaml/astro's <Map>.
// Other components: <FullPageMap> (a map that fills the window) and
// <Scrollytelling> (a story map). See https://docs.maplibre-yaml.org/integrations/astro/
import Layout from '../layouts/Layout.astro';
import { Map } from '@maplibre-yaml/astro';
---

<Layout title="{{projectName}}">
  <main>
    <h1>{{projectName}}</h1>
    <p>
      This map is <code>public/configs/map.yaml</code>. Edit it, save, and the page reloads.
    </p>

    <!-- src is a file in public/. On GitHub Pages (base set in astro.config.mjs)
         the component looks for it under your base for you. -->
    <Map src="/configs/map.yaml" height="70vh" />
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 16px;
  }
</style>
