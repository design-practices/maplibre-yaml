---
// A page that renders public/configs/map.yaml with the <ml-map> web component.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{projectName}}</title>
  <style>
    body { margin: 0; }
    /* <ml-map> has no size of its own: without a height the map is invisible. */
    ml-map { display: block; width: 100%; height: 100vh; }
  </style>
</head>
<body>
  <ml-map src="/configs/map.yaml"></ml-map>

  <script>
    // maplibre-gl 6 loads its worker from a separate file. Inside a Vite/Astro
    // bundle it cannot find that file by itself, so tell it where it is.
    import { setWorkerUrl } from 'maplibre-gl';
    import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
    import '@maplibre-yaml/core/register';
    import 'maplibre-gl/dist/maplibre-gl.css';

    setWorkerUrl(workerUrl);
  </script>
</body>
</html>
