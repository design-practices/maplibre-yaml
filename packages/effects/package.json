{
  "name": "@maplibre-yaml/effects",
  "version": "0.0.0",
  "description": "EXPERIMENTAL shader effects for maplibre-yaml documents: registerEffect(), the extrusions backend, and the tonal-hatch and blueprint built-ins",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register.browser": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.browser.js"
    },
    "./index.browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist",
    "register.js",
    "README.md"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.browser.js",
    "./register.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "@maplibre-yaml/core": "workspace:*",
    "@maplibre/geojson-vt": "6.1.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@maplibre/vt-pbf": "4.3.0",
    "@types/node": "^20.0.0",
    "earcut": "3.0.2",
    "maplibre-gl": "^5.24.0",
    "pbf": "4.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0"
  },
  "keywords": [
    "maplibre",
    "maps",
    "yaml",
    "webgl",
    "shader",
    "effects",
    "crosshatch"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/design-practices/maplibre-yaml.git",
    "directory": "packages/effects"
  },
  "bugs": {
    "url": "https://github.com/design-practices/maplibre-yaml/issues"
  },
  "homepage": "https://github.com/design-practices/maplibre-yaml#readme"
}
