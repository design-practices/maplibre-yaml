{
  "name": "maplibre-yaml",
  "version": "0.1.0",
  "description": "Runs @maplibre-yaml/cli as `npx maplibre-yaml` (init, validate, preview, emit, schema, bake) with no install.",
  "type": "module",
  "bin": {
    "maplibre-yaml": "bin.js"
  },
  "files": [
    "bin.js",
    "README.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@maplibre-yaml/cli": "workspace:^"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "keywords": [
    "maplibre",
    "maplibre-yaml",
    "yaml",
    "maps",
    "cli"
  ],
  "homepage": "https://docs.maplibre-yaml.org/cli/reference/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/design-practices/maplibre-yaml.git",
    "directory": "packages/maplibre-yaml"
  },
  "bugs": {
    "url": "https://github.com/design-practices/maplibre-yaml/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
