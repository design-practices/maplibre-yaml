{
  "name": "maplibre-yaml",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative Maplibre web maps with YAML configuration",
  "repository": {
    "type": "git",
    "url": "https://github.com/design-practices/maplibre-yaml.git"
  },
  "keywords": [
    "maplibre",
    "maps",
    "yaml",
    "geojson",
    "geospatial",
    "web-components"
  ],
  "author": "mariogiampieri",
  "license": "MIT",
  "scripts": {
    "prepare": "sh scripts/beads-sync.sh",
    "presubmit": "sh scripts/lane-shim.sh pnpm run presubmit:raw",
    "presubmit:raw": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm docs:validate-snippets",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "docs:validate-snippets": "node scripts/validate-doc-snippets.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bash scripts/release.sh",
    "verify:serve": "node e2e/server.mjs",
    "verify:docs-gallery": "node scripts/verify-docs-gallery.mjs",
    "verify:browser": "playwright test",
    "verify:browser:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.62.0",
    "@types/pngjs": "^6.0.5",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "^5.24.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
